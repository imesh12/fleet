{
  "name": "trackigniter8-backend-foundation",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:web": "npm run dev -w @trackigniter8/web",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && npm run build -w @trackigniter8/web",
    "lint": "npm run typecheck",
    "typecheck": "tsc -b --pretty false && npm run typecheck -w @trackigniter8/web",
    "prisma:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "prisma:seed": "tsx packages/db/prisma/seed.ts",
    "api:routes": "tsx scripts/generate-route-inventory.ts",
    "api:permissions": "tsx scripts/check-permission-coverage.ts",
    "api:verify-seed": "tsx scripts/verify-seed.ts",
    "api:smoke": "tsx scripts/api-smoke-test.ts",
    "api:response-check": "tsx scripts/check-response-envelope.ts",
    "api:openapi-check": "tsx scripts/check-openapi.ts",
    "web:routes": "tsx scripts/check-frontend-routes.ts",
    "repo:hygiene": "tsx scripts/check-repository-hygiene.ts"
  },
  "prisma": {
    "seed": "tsx packages/db/prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
