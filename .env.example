NODE_ENV=development
APP_NAME=trackigniter8-api
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=3000
APP_LOG_LEVEL=info
API_PREFIX=/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackigniter8?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
MAIL_PROVIDER=console
MAIL_FROM_EMAIL=no-reply@trackigniter8.local
MAIL_FROM_NAME=Trackigniter8 Notifications
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
SHOW_ERROR_DETAILS=false

SUPER_ADMIN_EMAIL=admin@trackigniter8.local
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Administrator
