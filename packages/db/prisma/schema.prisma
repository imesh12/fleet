  notificationDeliveries    NotificationDelivery[]

  @@index([organizationId, status])
  @@index([trackingNotificationRuleId, status])
  @@index([trackingAlertEventId, status])
  @@index([tripId, status])
  @@index([triggeredAt])
}

model BackgroundJobDefinition {
  id              String                       @id @default(cuid())
  organizationId  String?
  name            String
  code            String
  jobType         BackgroundJobType
  description     String?
  status          MasterDataStatus             @default(ACTIVE)
  schedule        String?
  scheduleType    BackgroundJobScheduleType    @default(MANUAL)
  cronExpression  String?
  intervalSeconds Int?
  maxRetries      Int                          @default(3)
  backoffStrategy BackgroundJobBackoffStrategy @default(EXPONENTIAL)
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  lockedAt        DateTime?
  lockedBy        String?
  config          Json?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  organization    Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs            BackgroundJobRun[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([jobType, status])
  @@index([scheduleType, status, nextRunAt])
  @@index([lockedAt])
}

model BackgroundJobRun {
  id                       String                 @id @default(cuid())
  backgroundJobDefinitionId String
  organizationId           String?
  status                   BackgroundJobRunStatus @default(PENDING)
  idempotencyKey           String?
  startedAt                DateTime?
  finishedAt               DateTime?
  triggeredByUserId        String?
  summary                  Json?
  metadata                 Json?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  backgroundJobDefinition  BackgroundJobDefinition @relation(fields: [backgroundJobDefinitionId], references: [id], onDelete: Cascade)
  organization             Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggeredByUser          User?                  @relation("BackgroundJobRunTriggeredByUser", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  logs                     BackgroundJobRunLog[]

  @@index([backgroundJobDefinitionId, status])
  @@index([organizationId, status])
  @@index([triggeredByUserId])
  @@index([idempotencyKey])
}

model BackgroundJobRunLog {
  id                 String           @id @default(cuid())
  backgroundJobRunId String
  level              String
  message            String
  metadata           Json?
  createdAt          DateTime         @default(now())
  backgroundJobRun   BackgroundJobRun @relation(fields: [backgroundJobRunId], references: [id], onDelete: Cascade)

  @@index([backgroundJobRunId, createdAt])
}

model NotificationProvider {
  id             String                   @id @default(cuid())
  organizationId String?
  name           String
  code           String
  providerType   NotificationProviderType
  channel        NotificationChannel
  description    String?
  status         MasterDataStatus         @default(ACTIVE)
  config         Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templates      NotificationTemplate[]
  deliveries     NotificationDelivery[]
  trackingNotificationRules TrackingNotificationRule[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([channel, status])
}

model NotificationTemplate {
  id             String               @id @default(cuid())
  organizationId String?
  notificationProviderId String?
  name           String
  code           String
  channel        NotificationChannel
  subjectTemplate String?
  bodyTemplate   String
  description    String?
  status         MasterDataStatus     @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationProvider NotificationProvider? @relation(fields: [notificationProviderId], references: [id], onDelete: SetNull)
  deliveries     NotificationDelivery[]
  trackingNotificationRules TrackingNotificationRule[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([channel, status])
  @@index([notificationProviderId, status])
}

model NotificationDelivery {
  id                         String                    @id @default(cuid())
  organizationId             String?
  trackingAlertEventId       String?
  trackingNotificationRuleId String?
  trackingNotificationEventId String?
  notificationProviderId     String?
  notificationTemplateId     String?
  channel                    NotificationChannel
  status                     NotificationDeliveryStatus @default(PENDING)
  recipient                  String?
  subject                    String?
  body                       String
  attemptCount               Int                       @default(0)
  maxAttempts                Int                       @default(3)
  nextAttemptAt              DateTime?
  lastAttemptAt              DateTime?
  sentAt                     DateTime?
  failedAt                   DateTime?
  canceledAt                 DateTime?
  externalMessageId          String?
  errorMessage               String?
  failureReason              String?
  providerResponse           Json?
  metadata                   Json?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  organization               Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingAlertEvent         TrackingAlertEvent?       @relation(fields: [trackingAlertEventId], references: [id], onDelete: SetNull)
  trackingNotificationRule   TrackingNotificationRule? @relation(fields: [trackingNotificationRuleId], references: [id], onDelete: SetNull)
  trackingNotificationEvent  TrackingNotificationEvent? @relation(fields: [trackingNotificationEventId], references: [id], onDelete: SetNull)
  notificationProvider       NotificationProvider?     @relation(fields: [notificationProviderId], references: [id], onDelete: SetNull)
  notificationTemplate       NotificationTemplate?     @relation(fields: [notificationTemplateId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([trackingAlertEventId, status])
  @@index([trackingNotificationRuleId, status])
  @@index([trackingNotificationEventId, status])
  @@index([notificationProviderId, status])
  @@index([channel, status])
  @@index([status, nextAttemptAt])
}

model EscalationPolicy {
  id             String           @id @default(cuid())
  organizationId String?
  name           String
  code           String
  description    String?
  status         MasterDataStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps          EscalationPolicyStep[]
  events         EscalationEvent[]
  trackingNotificationRules TrackingNotificationRule[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model EscalationPolicyStep {
  id                 String           @id @default(cuid())
  escalationPolicyId String
  sequence           Int
  channel            NotificationChannel
  delayMinutes       Int              @default(0)
  recipientMetadata  Json?
  templateOverride   String?
  isActive           Boolean          @default(true)
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  escalationPolicy   EscalationPolicy @relation(fields: [escalationPolicyId], references: [id], onDelete: Cascade)

  @@unique([escalationPolicyId, sequence])
  @@index([escalationPolicyId, isActive])
}

model EscalationEvent {
  id                  String                @id @default(cuid())
  organizationId      String?
  trackingAlertEventId String?
  escalationPolicyId  String?
  actorUserId         String?
  status              EscalationEventStatus @default(OPEN)
  escalationLevel     Int                   @default(1)
  title               String
  message             String
  acknowledgedAt      DateTime?
  resolvedAt          DateTime?
  metadata            Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingAlertEvent  TrackingAlertEvent?   @relation(fields: [trackingAlertEventId], references: [id], onDelete: SetNull)
  escalationPolicy    EscalationPolicy?     @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  actorUser           User?                 @relation("EscalationEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([trackingAlertEventId, status])
  @@index([escalationPolicyId, status])
  @@index([actorUserId])
}
