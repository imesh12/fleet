  legalName       String?
  email           String?
  phone           String?
  taxIdentifier   String?
  status          OrganizationStatus    @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  users           OrganizationUser[]
  customerAccounts CustomerAccount[]
  settings        OrganizationSetting[]
  departments     Department[]
  businessUnits   BusinessUnit[]
  vehicleTypes    VehicleType[]
  vehicleGroups   VehicleGroup[]
  vehicleMakes    VehicleMake[]
  vehicleModels   VehicleModel[]
  vehicles        Vehicle[]
  fleetReadinessProfiles FleetReadinessProfile[]
  vehicleComplianceTypes VehicleComplianceType[]
  driverComplianceTypes DriverComplianceType[]
  assignmentPolicies AssignmentPolicy[]
  tripTemplates    TripTemplate[]
  plannedTrips     PlannedTrip[]
  dispatchQueues   DispatchQueue[]
  trips           Trip[]
  dispatchActions DispatchAction[]
  driverGroups    DriverGroup[]
  driverSkills    DriverSkill[]
  drivers         Driver[]
  driverVehicleAssignments DriverVehicleAssignment[]
  vendorCategories VendorCategory[]
  vendors         Vendor[]
  serviceRoutes   ServiceRoute[]
  serviceAreas    ServiceArea[]
  serviceRouteGroups ServiceRouteGroup[]
  serviceRouteTemplates ServiceRouteTemplate[]
  invitations     OrganizationInvitation[]
  trackingProviders TrackingProvider[]
  externalTrackingDevices ExternalTrackingDevice[]
  vehicleDeviceMappings VehicleDeviceMapping[]
  trackingProviderSyncRuns TrackingProviderSyncRun[]
  trackingAlertRules TrackingAlertRule[]
  trackingAlertEvents TrackingAlertEvent[]
  geofences Geofence[]
  geofenceEvaluationRuns GeofenceEvaluationRun[]
  geofenceEvents GeofenceEvent[]
  trackingEvaluationRuns TrackingEvaluationRun[]
  trackingNotificationRules TrackingNotificationRule[]
  trackingNotificationEvents TrackingNotificationEvent[]
  backgroundJobDefinitions BackgroundJobDefinition[]
  backgroundJobRuns BackgroundJobRun[]
  notificationProviders NotificationProvider[]
  notificationTemplates NotificationTemplate[]
  notificationDeliveries NotificationDelivery[]
  escalationPolicies EscalationPolicy[]
  escalationEvents EscalationEvent[]
  maintenanceCategories MaintenanceCategory[]
  maintenanceServiceTasks MaintenanceServiceTask[]
  inspectionChecklistTemplates InspectionChecklistTemplate[]
  vehicleMaintenancePlans VehicleMaintenancePlan[]
  maintenanceRequests MaintenanceRequest[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  fuelTypes FuelType[]
  fuelVendorProfiles FuelVendorProfile[]
  fuelCards FuelCard[]
  fuelTanks FuelTank[]
  fuelPolicies FuelPolicy[]
  fuelRequests FuelRequest[]
  fuelEntries FuelEntry[]
  reportCategories ReportCategory[]
  reportDefinitions ReportDefinition[]
  reportFilterPresets ReportFilterPreset[]
  reportRuns ReportRun[]
  reportExportJobs ReportExportJob[]
  dashboardWidgetDefinitions DashboardWidgetDefinition[]
  dashboardSnapshots DashboardSnapshot[]
  appMenuGroups AppMenuGroup[]
  appMenuItems AppMenuItem[]
  appPages AppPage[]
  featureFlags FeatureFlag[]
  storageProviders StorageProvider[]
  storageBuckets StorageBucket[]
  fileObjects FileObject[]
  fileAttachments FileAttachment[]
  documentRetentionPolicies DocumentRetentionPolicy[]
  vehiclePositions VehiclePosition[]
  vehicleTelemetryEvents VehicleTelemetryEvent[]

  @@index([status])
  @@index([name])
}

model OrganizationUser {
  id             String                       @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationUserRole        @default(MEMBER)
  status         OrganizationMembershipStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
}

model CustomerAccount {
  id              String                 @id @default(cuid())
  organizationId  String
  name            String
  code            String
  email           String?
  phone           String?
  billingAddress  String?
  notes           String?
  status          CustomerAccountStatus  @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        CustomerContact[]
  locations       CustomerLocation[]
  vehicles        Vehicle[]
  drivers         Driver[]
  plannedTrips    PlannedTrip[]
  trips           Trip[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([name])
}

