model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActorUser")
  organizationMemberships OrganizationUser[]
  sentOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInvitationSentByUser")
  tripEvents TripEvent[] @relation("TripEventActorUser")
  dispatchActions DispatchAction[] @relation("DispatchActionActorUser")
  trackingProviderSyncRuns TrackingProviderSyncRun[]
  trackingEvaluationRuns TrackingEvaluationRun[]
  backgroundJobRunsTriggered BackgroundJobRun[] @relation("BackgroundJobRunTriggeredByUser")
  escalationEvents EscalationEvent[] @relation("EscalationEventActorUser")
  createdFileObjects FileObject[] @relation("FileObjectCreatedByUser")
  fileAccessLogs FileAccessLog[] @relation("FileAccessLogUser")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenId       String    @unique
  hashedToken   String
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?
  revokedReason String?
  ipAddress     String?
  userAgent     String?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id          String         @id @default(cuid())
  actorType   AuditActorType
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())
  actorUser   User?          @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id          String                 @id @default(cuid())
  key         String                 @unique
  value       String
  valueType   SystemSettingValueType
  category    String
  isSecret    Boolean                @default(false)
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([category])
  @@index([isSecret])
}

model AppMenuGroup {
  id                 String           @id @default(cuid())
  organizationId     String?
  title              String
  slug               String
  path               String?
  icon               String?
  sortOrder          Int              @default(0)
  status             NavigationStatus @default(ACTIVE)
  requiredPermission String?
  moduleKey          String
  description        String?
  comingSoonMessage  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems          AppMenuItem[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([moduleKey])
  @@index([sortOrder])
}

model AppMenuItem {
  id                 String           @id @default(cuid())
  organizationId     String?
  menuGroupId        String?
  parentId           String?
  appPageId          String?
  title              String
  slug               String
  path               String?
  icon               String?
  sortOrder          Int              @default(0)
  status             NavigationStatus @default(ACTIVE)
  requiredPermission String?
  moduleKey          String
  description        String?
  comingSoonMessage  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuGroup          AppMenuGroup?    @relation(fields: [menuGroupId], references: [id], onDelete: SetNull)
  parent             AppMenuItem?     @relation("AppMenuItemChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           AppMenuItem[]    @relation("AppMenuItemChildren")
  appPage            AppPage?         @relation(fields: [appPageId], references: [id], onDelete: SetNull)

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([menuGroupId, sortOrder])
  @@index([parentId])
  @@index([moduleKey])
}

model AppPage {
  id                 String           @id @default(cuid())
  organizationId     String?
  title              String
  slug               String
  path               String
  icon               String?
  sortOrder          Int              @default(0)
  parentId           String?
  status             NavigationStatus @default(ACTIVE)
  requiredPermission String?
  moduleKey          String
  description        String?
  comingSoonMessage  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent             AppPage?         @relation("AppPageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           AppPage[]        @relation("AppPageChildren")
  menuItems          AppMenuItem[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([parentId])
  @@index([moduleKey])
}

model FeatureFlag {
  id             String               @id @default(cuid())
  organizationId String?
  key            String
  name           String
  description    String?
  enabled        Boolean              @default(false)
  rolloutStatus  FeatureRolloutStatus @default(PLANNED)
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId, enabled])
  @@index([rolloutStatus])
}

model StorageProvider {
  id             String              @id @default(cuid())
  organizationId String?
  name           String
  code           String
  providerType   StorageProviderType
  description    String?
  status         MasterDataStatus    @default(ACTIVE)
  config         Json?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buckets        StorageBucket[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([providerType])
}

model StorageBucket {
  id                String           @id @default(cuid())
  organizationId    String?
  storageProviderId String
  name              String
  code              String
  description       String?
  status            MasterDataStatus @default(ACTIVE)
  config            Json?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageProvider   StorageProvider  @relation(fields: [storageProviderId], references: [id], onDelete: Cascade)
  files             FileObject[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([storageProviderId])
}

model FileObject {
  id               String           @id @default(cuid())
  organizationId   String
  bucketId         String?
  originalFileName String
  storedFileName   String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  status           FileObjectStatus @default(ACTIVE)
  visibility       FileVisibility   @default(PRIVATE)
  createdByUserId  String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket           StorageBucket?   @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  createdByUser    User?            @relation("FileObjectCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions         FileVersion[]
  accessLogs       FileAccessLog[]
  attachments      FileAttachment[]

  @@index([organizationId, status])
  @@index([bucketId])
  @@index([createdByUserId])
  @@index([originalFileName])
}

model FileVersion {
  id             String       @id @default(cuid())
  fileObjectId   String
  versionNumber  Int
  storedFileName String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  checksum       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  fileObject     FileObject   @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)

  @@unique([fileObjectId, versionNumber])
  @@index([fileObjectId])
}

model FileAccessLog {
  id             String      @id @default(cuid())
  fileObjectId   String
  userId         String?
  action         String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime    @default(now())
  fileObject     FileObject  @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)
  user           User?       @relation("FileAccessLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([fileObjectId, createdAt])
  @@index([userId])
  @@index([action])
}

model FileAttachment {
  id             String               @id @default(cuid())
  organizationId String
  fileObjectId   String
  entityType     String
  entityId       String
  attachmentType String
  description    String?
  status         FileAttachmentStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileObject     FileObject           @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@index([fileObjectId])
  @@index([status])
}

model DocumentRetentionPolicy {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  code           String
  entityType     String?
  retentionDays  Int
  archiveAfterDays Int?
  description    String?
  status         MasterDataStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([entityType])
}

