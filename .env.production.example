NODE_ENV=production
APP_NAME=trackigniter8-api
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=3000
APP_LOG_LEVEL=info
API_PREFIX=/api/v1

DATABASE_URL=postgresql://trackigniter8:${POSTGRES_PASSWORD}@postgres:5432/trackigniter8?schema=public
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

CORS_ORIGINS=https://app.example.com
CORS_CREDENTIALS=false

JWT_ACCESS_SECRET=replace-with-strong-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-different-strong-random-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
SHOW_ERROR_DETAILS=false

MAIL_PROVIDER=console
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Trackigniter8 Notifications

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=replace-with-one-time-bootstrap-password
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Administrator

NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Future integration placeholders only. Do not commit real values.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
WEBHOOK_SIGNING_SECRET=
STORAGE_PROVIDER=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TRACCAR_BASE_URL=
TRACCAR_API_TOKEN=
